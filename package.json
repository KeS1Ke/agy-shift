{
  "name": "agy-shift",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run sync-version && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:rust": "cargo test --package agy-shift --lib",
    "pretauri:dev": "npm run typecheck",
    "tauri:dev": "node scripts/tauri-dev.cjs",
    "tauri": "node scripts/tauri.cjs",
    "build:nsis": "node scripts/tauri.cjs build --bundles nsis",
    "build:exe": "node scripts/tauri.cjs build --no-bundle",
    "build:inno": "node scripts/build-inno.cjs",
    "build:inno:only": "node scripts/build-inno.cjs --installer-only",
    "sync-version": "node scripts/sync-version.js"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
